# LLM endpoint (OpenAI-compatible)
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-key-here
DEFAULT_MODEL=grok-4.3

# Port overrides (optional, defaults below)
# OWUI_PORT=80
# MCPJUNGLE_PORT=8080
# GHIDRA_MCP_HEADLESS_PORT=3334    # Ghidra headless REST API
# GHIDRA_MCP_BRIDGE_PORT=3335      # Ghidra MCP bridge (Streamable HTTP, same container)

# Ghidra MCP auth token (REQUIRED when binding to 0.0.0.0)
# GHIDRA_MCP_AUTH_TOKEN=changeme

# Open WebUI admin credentials (used during bootstrap to auto-bind MCP tools to the model)
# WEBUI_ADMIN_EMAIL=demo@demo.demo
# WEBUI_ADMIN_PASSWORD=demo

# Default model params (function_calling=native enables native tool calling globally)
# DEFAULT_MODEL_PARAMS={"function_calling":"native"}