# LLM endpoint (OpenAI-compatible)
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-key-here

# Open WebUI secret key (generate with: openssl rand -hex 32)
# Must be stable across restarts to preserve tool credentials
WEBUI_SECRET_KEY=change-me-to-a-random-string

# Port overrides (optional, defaults below)
# OWUI_PORT=80
# MCPJUNGLE_PORT=8080
# GHIDRA_MCP_HEADLESS_PORT=3334    # Ghidra headless REST API
# GHIDRA_MCP_BRIDGE_PORT=3335      # Ghidra MCP bridge (Streamable HTTP)

# Ghidra MCP auth token (REQUIRED when binding to 0.0.0.0)
# GHIDRA_MCP_AUTH_TOKEN=changeme